# ============================================================
# SERVICIO CLOUD (Render) — sin impresora, detras de nginx
# ============================================================

# MongoDB (MISMA URI para local + cloud)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
SECRET_KEY=cambialo-esta-clave-secreta-del-deploy
# IMPORTANTE: Mismo valor que render.yaml para sesion compartida
MONGO_DB=sistema_boleteria
# MONGO_TIMEOUT_MS=5000
# MIN_POOL_SIZE=0
# MAX_POOL_SIZE=100
# MONGO_TLS_INSECURE=false

# Servidor (Docker en Render)
FLASK_HOST=0.0.0.0
PORT=8000
FLASK_DEBUG=0
OPEN_BROWSER=0
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH_MB=16

# Sesión (HTTPS en Render)
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DAYS=7
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Seguridad (detras de nginx/reverse proxy)
TRUST_PROXY_HEADERS=1
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=cambia-esta-clave
LOGIN_MAX_INTENTOS=50

# Impresora (no hay en cloud)
# PRINTER_HOST=
# PRINTER_PORT=9100
TZ_OFFSET=-05:00

# Respaldos (no aplican en cloud — disco no persistente)
# BACKUP_DIR=
# BACKUP_KEEP=

# Rifa
NOMBRE_RIFA=
VALOR_BOLETA=10000
