# Copia este archivo a `.env` y completa los valores reales. NUNCA subas .env
# al repositorio (ya está en .gitignore). Genera la SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Conexión MongoDB (Atlas u otro) ──
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta

# ── Base de datos (opcional) ──
MONGO_DB=sistema_boleteria
# MONGO_TIMEOUT_MS=5000
# MIN_POOL_SIZE=0
# MAX_POOL_SIZE=100
# MONGO_TLS_INSECURE=false

# ── Rifas ──
NOMBRE_RIFA=Asociacion De Vendedores Rifas Transparencia
VALOR_BOLETA=70000
# COMISION_POR_BOLETA=10000

# ── Servidor ──
FLASK_HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
# OPEN_BROWSER=0

# ── Seguridad (obligatorio detrás de un reverse proxy HTTPS) ──
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DAYS=7
SESSION_IDLE_TIMEOUT_SECONDS=1800
TRUST_PROXY_HEADERS=1

# ── Usuario admin inicial (cámbialo) ──
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=cambiar-por-una-clave-fuerte

# ── Límites ──
MAX_CONTENT_LENGTH_MB=16

# ── Respaldos automáticos (scripts/backup.py) ──
# BACKUP_DIR=respaldos
# BACKUP_KEEP=30
