# MongoDB
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
SECRET_KEY=cambia-esta-clave-secreta
# IMPORTANTE: SECRET_KEY debe ser IDÉNTICO en ambas instancias (local + cloud) para que la sesión funcione en ambas
MONGO_DB=sistema_boleteria
# MONGO_TIMEOUT_MS=5000
# MIN_POOL_SIZE=0
# MAX_POOL_SIZE=100
# MONGO_TLS_INSECURE=false

# Servidor
FLASK_HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
OPEN_BROWSER=0
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH_MB=16

# Sesión (pon SESSION_COOKIE_SECURE=1 si usas HTTPS)
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DAYS=7
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Seguridad
TRUST_PROXY_HEADERS=1
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=cambia-esta-clave
LOGIN_MAX_INTENTOS=50

# Impresora térmica (dejar vacío si no hay impresora)
# PRINTER_HOST=
# PRINTER_PORT=9100
# TZ_OFFSET=-05:00

# Respaldos
# BACKUP_DIR=respaldos
# BACKUP_KEEP=30
