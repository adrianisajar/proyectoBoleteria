# ============================================================
# SERVIDOR LOCAL (PC-BOLETERIA) — con impresora y respaldos en disco
# ============================================================

# MongoDB
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
SECRET_KEY=cambialo-esta-clave-secreta-del-deploy
# IMPORTANTE: Mismo valor que render.yaml para que sesion funcione en ambas instancias
MONGO_DB=sistema_boleteria
# MONGO_TIMEOUT_MS=5000
# MIN_POOL_SIZE=0
# MAX_POOL_SIZE=100
# MONGO_TLS_INSECURE=false

# Servidor
FLASK_HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
OPEN_BROWSER=1
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH_MB=16

# Sesión (HTTP local, sin proxy)
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DAYS=7
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Seguridad (sin proxy local)
TRUST_PROXY_HEADERS=0
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=cambia-esta-clave
LOGIN_MAX_INTENTOS=50

# Impresora térmica
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
TZ_OFFSET=-05:00

# Respaldos en disco local
BACKUP_DIR=respaldos
BACKUP_KEEP=30
